{
  "name": "universal-games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./games/*\" dev",
    "build": "pnpm -r build && tsx scripts/assemble.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "game:status": "tsx scripts/game-gates.ts status",
    "game:check": "tsx scripts/game-gates.ts check",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler versions upload"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.129.1"
  }
}
